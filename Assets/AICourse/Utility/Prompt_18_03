}

public abstract class Node : INode {
    public GameObject gameObject { get; private set; }
    public DynamicBlackboard blackboard { get { return gameObject.GetComponent<DynamicBlackboard>(); } }
    
    public virtual void Contextualize(GameObject gm) { gameObject = gm; }
    public Status Tick() { /* ... */ return OnTick(); }
    public abstract Status OnTick();
}

public abstract class Action : Node {
    public Action(string name) : base(name) { }
}

